<?xml version="1.0" ?>
<sdf version="1.9"><world name="underground_demo">
<physics name="physics" type="ignored"><max_step_size>0.005</max_step_size><real_time_factor>1</real_time_factor></physics>
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
<light name="mine_light" type="directional"><pose>0 0 8 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><attenuation><range>100</range><constant>0.9</constant></attenuation><direction>0.2 0.1 -1</direction></light>
<model name="floor"><static>true</static><link name="link"><collision name="collision"><geometry><box><size>25 12 0.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>25 12 0.2</size></box></geometry><material><ambient>0.37 0.32 0.27 1</ambient><diffuse>0.37 0.32 0.27 1</diffuse></material></visual></link><pose>0 0 -0.1 0 0 0</pose></model>
<model name="wall_north"><static>true</static><pose>0 1.2 0.8 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>6 0.35 1.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>6 0.35 1.6</size></box></geometry><material><ambient>0.32 0.3 0.29 1</ambient></material></visual></link></model>
<model name="wall_south"><static>true</static><pose>0 -1.2 0.8 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>6 0.35 1.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>6 0.35 1.6</size></box></geometry><material><ambient>0.32 0.3 0.29 1</ambient></material></visual></link></model>
<model name="robot_1">
 <pose>-5 0 0.35 0 0 0</pose>
 <link name="base_link">
  <inertial><mass>180</mass><inertia><ixx>15</ixx><iyy>26</iyy><izz>30</izz></inertia></inertial>
  <collision name="chassis_collision"><geometry><box><size>1.0 0.7 0.35</size></box></geometry></collision>
  <visual name="chassis_visual"><geometry><box><size>1.0 0.7 0.35</size></box></geometry><material><ambient>0.85 0.55 0.1 1</ambient><diffuse>0.85 0.55 0.1 1</diffuse></material></visual>
 </link>
 <link name="left_wheel">
  <pose>0 0.43 -0.13 -1.57079632679 0 0</pose>
  <inertial><mass>8</mass><inertia><ixx>0.15</ixx><iyy>0.15</iyy><izz>0.15</izz></inertia></inertial>
  <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.12</length></cylinder></geometry></collision>
  <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.12</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient></material></visual>
 </link>
 <link name="right_wheel">
  <pose>0 -0.43 -0.13 -1.57079632679 0 0</pose>
  <inertial><mass>8</mass><inertia><ixx>0.15</ixx><iyy>0.15</iyy><izz>0.15</izz></inertia></inertial>
  <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.12</length></cylinder></geometry></collision>
  <visual name="visual"><geometry><cylinder><radius>0.22</radius><length>0.12</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient></material></visual>
 </link>
 <joint name="left_wheel_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
 <joint name="right_wheel_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
 <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
  <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
  <wheel_separation>0.86</wheel_separation><wheel_radius>0.22</wheel_radius>
  <topic>/robot_1/cmd_vel</topic><odom_topic>/robot_1/odom</odom_topic>
  <frame_id>robot_1/odom</frame_id><child_frame_id>robot_1/base_link</child_frame_id>
  <odom_publish_frequency>20</odom_publish_frequency><max_linear_velocity>1.0</max_linear_velocity><max_angular_velocity>1.0</max_angular_velocity>
 </plugin>
 </model>
